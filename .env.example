NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=

# Proveedor de IA activo: claude (por defecto), gemini u openrouter. Solo se exige
# la configuración del proveedor elegido (ADR 0031, ADR 0033).
AI_PROVIDER=claude

# Con AI_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Con AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Con AI_PROVIDER=openrouter. El modelo no tiene valor por defecto: se elige en
# https://openrouter.ai/models y debe admitir tools y response_format.
# Ejemplos verificados: openai/gpt-4o-mini, google/gemini-3.8-flash, anthropic/claude-haiku-4.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

AI_RATE_LIMIT_USER_PER_MIN=15
AI_RATE_LIMIT_GLOBAL_PER_MIN=24
AI_RATE_LIMIT_MODERATION_GLOBAL_PER_MIN=12
